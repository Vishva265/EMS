            "type": "integer",
            "format": "int64"
          },
          "transferDate": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "newDepartmentId",
          "reason",
          "transferDate",
          "version"
        ]
      },
      "NewAccount": {
