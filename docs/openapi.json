            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{2,49}"
          },
          "password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 12
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
