            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "Active|Inactive"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
