  "components": {
    "schemas": {
      "Profile": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0,
            "pattern": "[A-Za-z ]+"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 160,
            "minLength": 0
          },
          "mobile": {
            "type": "string",
            "pattern": "[0-9]{10}"
          },
          "aadhaar": {
            "type": "string",
            "pattern": "[0-9]{12}"
          },
          "pan": {
            "type": "string",
            "pattern": "[A-Z]{5}[0-9]{4}[A-Z]"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string",
            "pattern": "Male|Female|Other"
          },
          "address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "departmentId": {
            "type": "integer",
            "format": "int64"
          },
          "roleId": {
            "type": "integer",
            "format": "int64"
          },
          "joiningDate": {
            "type": "string",
            "format": "date"
          },
          "annualSalary": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "pattern": "Active|Inactive"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "aadhaar",
          "address",
          "annualSalary",
          "dateOfBirth",
          "departmentId",
          "email",
          "fullName",
          "gender",
          "joiningDate",
          "mobile",
          "pan",
          "roleId",
          "status"
        ]
      },
