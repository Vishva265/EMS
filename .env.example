# Set these in your terminal or IDE; Spring does not automatically load this file.
DB_URL=jdbc:postgresql://localhost:5432/ems
DB_USER=ems_app
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-bytes
ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
# Optional: creates synthetic records and admin/manager/employee on an empty database.
DEMO_PASSWORD=replace-with-a-random-demo-password-of-at-least-12-characters
COOKIE_SECURE=false
